{
	"name": "lemma",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "bun --hot src/server/main.ts",
		"build": "rm -rf dist && bun build src/client/index.html --outdir dist --production --public-path=/",
		"start": "NODE_ENV=production bun src/server/main.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test:e2e": "playwright test",
		"check": "bun run typecheck && bun run lint && bun test && bun run test:e2e"
	},
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@types/bun": "1.4.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2"
	}
}
