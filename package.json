{
	"name": "lemma",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "bun run --parallel dev:server dev:client",
		"dev:server": "bun --watch src/server/main.ts",
		"dev:client": "bunx --bun vite",
		"build": "bunx --bun vite build",
		"start": "NODE_ENV=production bun src/server/main.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test:e2e": "playwright test",
		"check": "bun run typecheck && bun run lint && bun test && bun run test:e2e",
		"test:live": "LIVE=1 bun test --timeout 180000 src/server/agent/sdk.live.test.ts",
		"record:stream": "bun src/server/agent/record.ts"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.330",
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/source-serif-4": "5.3.1",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "1.4.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.8"
	},
	"imports": {
		"#components/*": "./src/client/components/*",
		"#lib/*": "./src/client/lib/*",
		"#hooks/*": "./src/client/hooks/*"
	}
}
